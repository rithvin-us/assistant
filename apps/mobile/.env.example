# Copy to apps/mobile/.env. Vite inlines VITE_* variables into the bundle, so
# only development placeholders belong here -- never a production secret.

# The Tauri shell (not the webview) makes this request.
#   desktop            -> http://127.0.0.1:8787
#   Android emulator   -> http://10.0.2.2:8787
#   physical device    -> http://<your-LAN-ip>:8787
VITE_SERVER_BASE_URL=http://127.0.0.1:8787

# Must match DEV_AUTH_TOKEN in the repository-root .env.
VITE_DEV_AUTH_TOKEN=change-me-local-only
