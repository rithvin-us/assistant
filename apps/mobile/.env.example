# Copy to apps/mobile/.env. Vite inlines VITE_* variables into the bundle, so
# only development placeholders belong here -- never a production secret.

# The Tauri shell (not the webview) makes this request. Leaving this unset is
# usually correct:
#   `pnpm dev` / `pnpm tauri dev`        -> http://127.0.0.1:8787
#   `pnpm build` / release-mode APK      -> https://assistant-server-vbrv.onrender.com
# Override only for a physical-device dev build against a LAN address, or when
# pointing a build at a staging URL:
#   Android emulator   -> http://10.0.2.2:8787
#   physical device    -> http://<your-LAN-ip>:8787
# VITE_SERVER_BASE_URL=http://127.0.0.1:8787

# Must match DEV_AUTH_TOKEN in the repository-root .env for local dev, and
# DEV_AUTH_TOKEN in the Render dashboard for a build that talks to the
# deployed service. If they do not match, every protected route returns 401.
VITE_DEV_AUTH_TOKEN=change-me-local-only
