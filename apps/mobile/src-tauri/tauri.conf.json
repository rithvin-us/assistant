{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assistant",
  "version": "0.1.0",
  "identifier": "com.rithvin.assistant",
  "build": {
    "beforeDevCommand": "npm --prefix apps/mobile run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix apps/mobile run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Assistant",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
