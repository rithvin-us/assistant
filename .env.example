# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- assistant-server ---------------------------------------------------------

# 0.0.0.0 so a phone or Android emulator on the same network can reach the dev
# server. Use 127.0.0.1 if you only ever run the desktop app.
ASSISTANT_BIND_ADDR=0.0.0.0:8787

# Development bearer token. Any non-empty string. This is a placeholder for real
# authentication, not a security control -- see crates/assistant-auth.
DEV_AUTH_TOKEN=change-me-local-only

# Supabase Postgres connection string. Leave unset to run without persistence;
# the server starts anyway and reports "degraded" from /v1/health.
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Comma-separated CORS origins for the Vite dev server.
ASSISTANT_ALLOWED_ORIGINS=http://localhost:1420

# Hard ceiling on rounds of tool execution within a single turn. A turn makes at
# most this many + 1 model calls. This is the only thing standing between a
# confused model and an unbounded spend, so the server owns it and the model
# cannot read or raise it.
ASSISTANT_MAX_TOOL_ROUNDS=4

# --- model provider (server only) ---------------------------------------------

# Anthropic credential. SERVER ONLY. It is read here and nowhere else, is never
# sent to the client, never logged, and never written to the database. There is
# deliberately no VITE_ equivalent: Vite inlines VITE_* variables into the
# shipped Android bundle, so a key there would ship to every device.
#
# Leave it unset to run without a model provider. The deterministic path still
# answers, and a turn that needs a model fails with `no_model_provider` rather
# than a fabricated reply.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Model identifier. Named here and nowhere else in the codebase.
ASSISTANT_MODEL=claude-opus-5

# Ceiling on one answer. A conversational reply does not need more, and this is
# the per-turn spend limit that is easiest to reason about.
ASSISTANT_MODEL_MAX_OUTPUT_TOKENS=4096

# Applies to a whole non-streaming request, and between reads of a streaming
# one -- a stream still producing tokens is not late.
ASSISTANT_MODEL_TIMEOUT_MS=60000

# Reasoning effort: low, medium, high, xhigh, max, or `none` to omit the field
# for a model that does not accept it. `low` is the default because a
# conversational turn is latency-critical and rarely needs deep reasoning.
ASSISTANT_MODEL_EFFORT=low

# How many past messages may be replayed to the model. This is the context
# window policy: recent turns are included, older ones are dropped. It is not
# memory -- see docs/MILESTONE-4.md.
ASSISTANT_CONTEXT_MAX_MESSAGES=40

RUST_LOG=assistant_server=debug,tower_http=debug,info
