# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- assistant-server ---------------------------------------------------------

# 0.0.0.0 so a phone or Android emulator on the same network can reach the dev
# server. Use 127.0.0.1 if you only ever run the desktop app.
ASSISTANT_BIND_ADDR=0.0.0.0:8787

# Supabase project reference (the subdomain of your project URL). When set, the
# server authenticates callers by verifying a Supabase-issued ES256 JWT against
# the project's public JWKS, and DEV_AUTH_TOKEN is not accepted. See ADR-0024.
# This is not a secret: verification needs only a public key.
# SUPABASE_PROJECT_REF=abcdefghijklmnop

# Development bearer token. Any non-empty string. Used ONLY when
# SUPABASE_PROJECT_REF is unset. It authenticates every caller as one fixed
# user, so it is a placeholder for real authentication and not a security
# control -- see crates/assistant-auth and ADR-0024.
DEV_AUTH_TOKEN=change-me-local-only

# Supabase Postgres connection string. Leave unset to run without persistence;
# the server starts anyway and reports "degraded" from /v1/health.
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Comma-separated CORS origins for the Vite dev server.
ASSISTANT_ALLOWED_ORIGINS=http://localhost:1420

# Hard ceiling on rounds of tool execution within a single turn. A turn makes at
# most this many + 1 model calls. This is the only thing standing between a
# confused model and an unbounded spend, so the server owns it and the model
# cannot read or raise it.
ASSISTANT_MAX_TOOL_ROUNDS=4

# --- model provider (server only) ---------------------------------------------

# OpenAI or Gemini API credential. SERVER ONLY. It is read here and nowhere else,
# is never sent to the client, never logged, and never written to the database.
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# Custom base URL (e.g. for Gemini OpenAI-compatible REST endpoint):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model identifier for completions. Default: gemini-3.6-flash
ASSISTANT_MODEL=gemini-3.6-flash

# Voice transcription model and language hint.
OPENAI_TRANSCRIPTION_MODEL=gemini-3.6-flash
OPENAI_TRANSCRIPTION_LANGUAGE=en

# Ceiling on one answer.
ASSISTANT_MODEL_MAX_OUTPUT_TOKENS=4096

# Applies to a whole non-streaming request, and between reads of a streaming one.
ASSISTANT_MODEL_TIMEOUT_MS=60000

# How many past messages may be replayed to the model.
ASSISTANT_CONTEXT_MAX_MESSAGES=40

# --- google ecosystem (server only, Milestone 5) ------------------------------

# Google Cloud OAuth 2.0 Web Application Client credentials. SERVER ONLY.
# Never commit real credentials, never expose to client bundles.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/oauth/callback

# 32-byte AES-256-GCM hex key (64 hex characters) used to encrypt OAuth refresh
# tokens at rest in the database. If omitted, a development fallback key is used with a warning.
# Generate with: openssl rand -hex 32
# CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

RUST_LOG=assistant_server=debug,tower_http=debug,info

# Cartesia API key for TTS and STT (Milestone voice integration)
# CARTESIA_API_KEY=sk_car_...